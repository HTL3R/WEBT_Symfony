# Symfony reads this file on every boot — it is required, even when the values
# are supplied by Docker. Everything here is a development default and is meant
# to be shared. Put anything genuinely secret in .env.local instead, which is
# not committed. Values set in docker-compose.yml take precedence over these.

APP_ENV=dev
APP_DEBUG=1

# In debug mode Symfony forces SHELL_VERBOSITY=3 (Kernel::preBoot), and because
# monolog is not installed its built-in logger then writes every debug event to
# error_log — which Apache prints to the container console, thousands of lines
# per request. Setting this explicitly keeps that override from happening.
# 0 = normal: only errors are logged, console commands stay at normal verbosity.
SHELL_VERBOSITY=0
APP_SECRET=dev-only-not-a-production-secret

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
DEFAULT_URI=http://localhost

# Sample data: read by Docker Compose (not by Symfony) when the container is
# created. 1 = on every start, empty the tables and reload the fixtures from
# src/DataFixtures/. 0 = skip, so data you entered survives restarts.
LOAD_FIXTURES=1